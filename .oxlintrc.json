{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "jsdoc", "node", "promise", "vitest"],
  "jsPlugins": ["eslint-plugin-tsdoc"],
  "categories": {
    "correctness": "error",
    "perf": "warn",
    "style": "allow",
    "suspicious": "warn"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "options": {
    "typeAware": true
  },
  "rules": {
    "no-case-declarations": "error",
    "no-empty": "error",
    "no-fallthrough": "error",
    "no-prototype-builtins": "error",
    "no-redeclare": "error",
    "no-regex-spaces": "error",
    "no-unexpected-multiline": "error",
    "no-array-constructor": "error",
    "no-unused-vars": "error",
    "typescript/ban-ts-comment": ["error", { "ts-expect-error": "allow-with-description" }],
    "typescript/consistent-type-imports": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-namespace": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/no-unnecessary-type-arguments": "off",
    "import/no-duplicates": "error",
    "jsdoc/check-tag-names": "off",
    "vitest/require-to-throw-message": "off",
    "vitest/valid-title": "off"
  },
  "ignorePatterns": ["**/node_modules/", "**/coverage/", "**/dist/", "**/docs/", "**/_site/"],
  "overrides": [
    {
      "files": ["src/**/*.ts"],
      "rules": {
        "tsdoc/syntax": "error",
        "unicorn/no-array-sort": "off"
      }
    },
    {
      "files": ["tests/**/*.ts"],
      "rules": {
        "typescript/no-explicit-any": "off"
      },
      "env": {
        "vitest": true
      }
    },
    {
      "files": ["examples/**/*.{ts,mts,js,mjs}"],
      "rules": {
        "no-unused-vars": "off",
        "no-console": "off"
      }
    },
    {
      "files": ["tests/RiwayaListsConsistency.test.ts"],
      "rules": {
        "vitest/no-conditional-expect": "off"
      }
    }
  ]
}
