{
  "name": "quran-meta",
  "version": "7.0.0",
  "description": "Quran metadata for 8 riwayas: surahs, ayahs, juz, hizb, pages, rukus, manzils and sajdas, with conversion between riwaya numberings",
  "keywords": [
    "ayah",
    "hafs",
    "hizb",
    "islam",
    "juz",
    "koran",
    "mushaf",
    "qiraat",
    "quran",
    "quran-metadata",
    "riwaya",
    "surah",
    "warsh"
  ],
  "homepage": "https://quran-center.github.io/quran-meta/",
  "license": "MIT",
  "author": "Huseyn Guliyev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quran-center/quran-meta.git"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/quran-meta.iife.js",
  "jsdelivr": "./dist/quran-meta.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hafs": {
      "types": "./dist/hafs.d.ts",
      "default": "./dist/hafs.js"
    },
    "./warsh": {
      "types": "./dist/warsh.d.ts",
      "default": "./dist/warsh.js"
    },
    "./qalun": {
      "types": "./dist/qalun.d.ts",
      "default": "./dist/qalun.js"
    },
    "./bazzi": {
      "types": "./dist/bazzi.d.ts",
      "default": "./dist/bazzi.js"
    },
    "./douri": {
      "types": "./dist/douri.d.ts",
      "default": "./dist/douri.js"
    },
    "./qunbul": {
      "types": "./dist/qunbul.d.ts",
      "default": "./dist/qunbul.js"
    },
    "./shuba": {
      "types": "./dist/shuba.d.ts",
      "default": "./dist/shuba.js"
    },
    "./sousi": {
      "types": "./dist/sousi.d.ts",
      "default": "./dist/sousi.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "default": "./dist/i18n/index.js"
    },
    "./i18n/async": {
      "types": "./dist/i18n/async.d.ts",
      "default": "./dist/i18n/async.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vitest",
    "build": "tsdown",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "tsc && tsc -p tests",
    "generate": "node scripts/generate-entries.ts && jiti examples/data-check/generate-ayah-map.ts",
    "generate:check": "node scripts/generate-entries.ts --check && jiti examples/data-check/generate-ayah-map.ts --check",
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm generate:check && pnpm test",
    "check:package": "publint --strict && attw --pack . --profile esm-only",
    "size": "node scripts/check-size.ts",
    "docs:api": "typedoc",
    "docs:site": "pnpm docs:api && node scripts/build-site.ts",
    "prepare": "simple-git-hooks",
    "prepack": "pnpm build",
    "release": "changelogen --release --push --publish",
    "release:rc": "changelogen --release --prerelease --publish --publishTag rc",
    "release:gh": "changelogen gh release",
    "up": "pnpm update -i -L",
    "verify": "jiti examples/data-check/index.ts",
    "verify:lists": "jiti examples/data-check/generate-riwayah-lists.ts all --check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "26.6.2",
    "@vitest/coverage-v8": "5.0.1",
    "changelogen": "^0.6.2",
    "eslint-plugin-tsdoc": "^0.5.3",
    "jiti": "^2.7.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "publint": "^0.3.24",
    "simple-git-hooks": "^2.14.0",
    "tsdown": "0.23.0",
    "typedoc": "^0.28.20",
    "typedoc-github-theme": "^0.4.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e"
}
